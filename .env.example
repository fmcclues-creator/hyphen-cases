# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin password for /admin (choose anything strong)
ADMIN_PASSWORD=change-me

# Where the game is hosted (public, used in links)
NEXT_PUBLIC_GAME_URL=https://claude.ai/artifact/YaLNBqSdH3S3G38ZbEh1nG

# Price per team in KWD
PRICE_KWD=6

# Payment gateway: "test" until MyFatoorah/Hesabe is approved, then "myfatoorah"
PAYMENT_MODE=test
MYFATOORAH_API_KEY=
MYFATOORAH_BASE=https://apitest.myfatoorah.com

# Public site URL (set after first deploy, e.g. https://hyphen-cases.vercel.app)
SITE_URL=http://localhost:3000

# Hesabe (PAYMENT_MODE=hesabe)
HESABE_BASE=https://sandbox.hesabe.com   # or https://api.hesabe.com for live
HESABE_MERCHANT_CODE=
HESABE_ACCESS_CODE=
HESABE_SECRET_KEY=   # 32 characters
HESABE_IV=           # 16 characters
